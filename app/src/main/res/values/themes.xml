<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, no system bars. Matches SDL3's Android sample. -->
    <style name="AppTheme.Fullscreen" parent="android:Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- The launcher screen: dark Material widgets with focus highlights for gamepads. -->
    <style name="LauncherTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/picker_bg</item>
        <item name="android:colorAccent">#FF3FA9F5</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
